{
  "name": "zy-component-lib",
  "version": "0.0.7",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.cjs"
    },
    "./styles": "./dist/index.css",
    "./dist/index.css": {
      "default": "./dist/index.css"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "gulp": "node --import tsx node_modules/gulp/bin/gulp -f ./internal/build/gulpfile.ts",
    "build": "npm run clean && npm run gulp",
    "build:vite": "vite build --config ./config/vite.config.prod.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@pnpm/types": "^1001.3.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "chalk": "^5.6.2",
    "consola": "^3.4.2",
    "gulp": "^5.0.1",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "rollup": "^4.54.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "unplugin-vue-macros": "^2.14.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "fast-glob": "^3.3.3",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.2.0",
    "vue-tsc": "^3.1.0"
  },
  "sideEffects": [
    "*/style/*"
  ]
}
